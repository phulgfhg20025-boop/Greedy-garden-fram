local function updateDelayFromInputs()
    local mins = tonumber(minuteBox.Text) or 0
    local secs = tonumber(secondBox.Text) or 0
    selectedLoopDelay = (mins * 60) + secs
    delayLabel.Text = string.format("Delay vòng lặp: %d phút %d giây", mins, secs)
end

minuteBox.FocusLost:Connect(updateDelayFromInputs)
secondBox.FocusLost:Connect(updateDelayFromInputs)

RunService.RenderStepped:Connect(function()
    local mousePos = UserInputService:GetMouseLocation()
    if draggingSlider1 then
        local relX = math.clamp((mousePos.X - sliderBg1.AbsolutePosition.X) / sliderBg1.AbsoluteSize.X, 0, 1)
        sliderFill1.Size = UDim2.new(relX, 0, 1, 0)
        sliderBtn1.Position = UDim2.new(relX, -7, -0.3, 0)
        selectedLoopDelay = math.floor(relX * 60)
        
        local m = math.floor(selectedLoopDelay / 60)
        local s = selectedLoopDelay % 60
        minuteBox.Text = tostring(m)
        secondBox.Text = tostring(s)
        delayLabel.Text = string.format("Delay vòng lặp: %d phút %d giây", m, s)
    end
    if draggingSlider2 then
        local relX = math.clamp((mousePos.X - sliderBg2.AbsolutePosition.X) / sliderBg2.AbsoluteSize.X, 0, 1)
        sliderFill2.Size = UDim2.new(relX, 0, 1, 0)
        sliderBtn2.Position = UDim2.new(relX, -7, -0.3, 0)
        clickInterval = math.floor((relX * 5.0) * 10) / 10
        if clickInterval < 0.05 then clickInterval = 0.05 end
        clickSpeedLabel.Text = string.format("Khoảng cách giữa click: %.1fs", clickInterval)
    end
end)


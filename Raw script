    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not mainDragging then
        eDragging = true
        eDragStart = input.Position
        eStartPos = btnEFloating.Position
    end

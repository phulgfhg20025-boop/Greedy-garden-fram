UserInputService.InputBegan:Connect(function(input)
    if isRecording and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) then
        local pos = input.Position
        if (pos.X < mainFrame.AbsolutePosition.X or pos.X > mainFrame.AbsolutePosition.X + mainFrame.AbsoluteSize.X or
           pos.Y < mainFrame.AbsolutePosition.Y or pos.Y > mainFrame.AbsolutePosition.Y + mainFrame.AbsoluteSize.Y) and
           (pos.X < btnEFloating.AbsolutePosition.X or pos.X > btnEFloating.AbsolutePosition.X + btnEFloating.AbsoluteSize.X or
            pos.Y < btnEFloating.AbsolutePosition.Y or pos.Y > btnEFloating.AbsolutePosition.Y + btnEFloating.AbsoluteSize.Y) then
            local adjustedY = pos.Y + 72
            table.insert(recordedActions, {Type = "Click", X = pos.X, Y = adjustedY})
        end
    end
end)

local function refreshMacroList()
    for _, child in ipairs(scrollingList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    local count = 0
    for macroName, data in pairs(savedMacros) do
        count = count + 1
        local btnMacro = Instance.new("TextButton", scrollingList)
        btnMacro.Size = UDim2.new(1, 0, 0, 32)
        btnMacro.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        btnMacro.TextColor3 = Color3.fromRGB(255, 255, 255)
        btnMacro.Text = macroName .. " (" .. #data .. " hành động)"
        btnMacro.TextSize = 11
        btnMacro.Font = Enum.Font.SourceSansBold
        Instance.new("UICorner", btnMacro).CornerRadius = UDim.new(0, 6)
        
        btnMacro.MouseButton1Click:Connect(function()
            recordedActions = data
            -- Khi bấm chọn macro mẫu từ danh sách, tự động set cấu hình 2 phút và 0.5s
            if macroName == "macro_mau" then
                selectedLoopDelay = 120
                clickInterval = 0.5
                minuteBox.Text = "2"
                secondBox.Text = "0"
                delayLabel.Text = "Delay vòng lặp: 2 phút 0 giây"
                clickSpeedLabel.Text = "Khoảng cách giữa click: 0.5s"
                sliderFill1.Size = UDim2.new(1, 0, 1, 0)
                sliderBtn1.Position = UDim2.new(1, -7, -0.3, 0)
                sliderFill2.Size = UDim2.new(0.1, 0, 1, 0)
                sliderBtn2.Position = UDim2.new(0.1, -7, -0.3, 0)
            end
            statusLabel.Text = "Đã chọn: " .. macroName .. " (Delay: 2 phút, Click: 0.5s)"
        end)
    end
    scrollingList.CanvasSize = UDim2.new(0, 0, 0, count * 38)
end

refreshMacroList()

btnSave.MouseButton1Click:Connect(function()
    local mName = nameBox.Text
    if mName == "" then mName = "macro_unnamed" end
    if #recordedActions == 0 then
        statusLabel.Text = "Lỗi: Chưa có hành động nào để lưu!"
        return
    end
    local copyTable = {}
    for _, v in ipairs(recordedActions) do
        table.insert(copyTable, v)
    end
    savedMacros[mName] = copyTable
    refreshMacroList()
    statusLabel.Text = "Đã lưu: " .. mName
end)

btnStart.MouseButton1Click:Connect(function()
    if #recordedActions == 0 then
        statusLabel.Text = "Lỗi: Chưa chọn macro!"
        return
    end
    if not isRunning then
        isRunning = true
        cursor.Visible = true
        statusLabel.Text = "Trạng thái: Đang chạy macro..."
        
        task.spawn(function()
            while isRunning do
                for _, action in ipairs(recordedActions) do
                    if not isRunning then break end
                    
                    if action.Type == "Click" then
                        local targetPos = UDim2.new(0, action.X - 16, 0, action.Y - 16)
                        local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
                        local tween = TweenService:Create(cursor, tweenInfo, {Position = targetPos})
                        tween:Play()
                        tween.Completed:Wait()
                        
                        VirtualInputManager:SendMouseButtonEvent(action.X, action.Y, 0, true, game, 1)
                        task.wait(0.05)
                        VirtualInputManager:SendMouseButtonEvent(action.X, action.Y, 0, false, game, 1)
                    elseif action.Type == "Key" then
                        VirtualInputManager:SendKeyEvent(true, action.Key, false, game)
                        task.wait(0.05)
                        VirtualInputManager:SendKeyEvent(false, action.Key, false, game)
                    end
                    
                    task.wait(clickInterval)
                end
                
                for i = selectedLoopDelay, 1, -1 do
                    if not isRunning then break end
                    local m = math.floor(i / 60)
                    local s = i % 60
                    statusLabel.Text = string.format("Chờ vòng mới: %02d:%02d", m, s)
                    task.wait(1)
                end
            end
        end)
    end
end)

btnStop.MouseButton1Click:Connect(function()
    isRunning = false
    if isRecording then
        isRecording = false
        setCompactMode(false)
    end
    cursor.Visible = false
    btnRecord.BackgroundColor3 = Color3.fromRGB(178, 34, 34)
    btnRecord.Text = "🔴 1. BẬT GHI (RECORD)"
    statusLabel.Text = "Trạng thái: Đã dừng."
end)

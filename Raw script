local function setCompactMode(compact)
    local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    if compact then
        delayLabel.Visible = false
        timeInputContainer.Visible = false
        sliderBg1.Visible = false
        clickSpeedLabel.Visible = false
        sliderBg2.Visible = false
        nameBox.Visible = false
        btnSave.Visible = false
        btnStart.Visible = false
        btnStop.Visible = false
        rightPanel.Visible = false
        
        btnRecord.Size = UDim2.new(0.9, 0, 0, 40)
        btnRecord.Position = UDim2.new(0.05, 0, 0, 10)
        statusLabel.Size = UDim2.new(0.9, 0, 0, 40)
        statusLabel.Position = UDim2.new(0.05, 0, 0, 55)
        
        TweenService:Create(mainFrame, tweenInfo, {Size = UDim2.new(0, 250, 0, 110)}):Play()
    else
        local tween = TweenService:Create(mainFrame, tweenInfo, {Size = UDim2.new(0, 460, 0, 440)})
        tween:Play()
        tween.Completed:Wait()
        
        btnRecord.Size = UDim2.new(0.9, 0, 0, 30)
        btnRecord.Position = UDim2.new(0.05, 0, 0, 180)
        statusLabel.Size = UDim2.new(0.9, 0, 0, 110)
        statusLabel.Position = UDim2.new(0.05, 0, 0, 285)
        
        delayLabel.Visible = true
        timeInputContainer.Visible = true
        sliderBg1.Visible = true
        clickSpeedLabel.Visible = true
        sliderBg2.Visible = true
        nameBox.Visible = true
        btnSave.Visible = true
        btnStart.Visible = true
        btnStop.Visible = true
        rightPanel.Visible = true
    end
end

